{
  "manifest_version": 3,
  "name": "Meet Compatibility for Firefox",
  "version": "1.0.1",
  "description": "This extension forces Google Meet to offer Firefox users features that are limited to Google Chrome.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meet-room-checkin@dejaydev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["webRequest", "webRequestBlocking"],
  "host_permissions": ["*://meet.google.com/*", "*://*.clients6.google.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["raw-microphone.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
